generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL_POOLED")
  directUrl = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  USER
  ORGANIZER
  TRACK_OPERATOR
  ANNOUNCER
  JUDGE
  ATHLETE
  VIEWER
}

enum EventStatus {
  DRAFT
  OPEN
  DRAWN
  IN_PROGRESS
  FINISHED
  CANCELLED
}

enum RegistrationStatus {
  ACTIVE
  CANCELLED
}

enum DrawStatus {
  DRAFT
  GENERATED
  PUBLISHED
  ARCHIVED
}

enum RunStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  ABSENT
  ELIMINATED
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String      @id @default(cuid())
  name         String?
  email        String      @unique
  emailVerified DateTime?
  image        String?
  passwordHash String?
  role         UserRole    @default(ORGANIZER)
  active       Boolean     @default(true)
  provisional  Boolean     @default(false)
  accessExpiresAt DateTime?
  managedById   String?
  lastLoginAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  createdEvents Event[]    @relation("EventCreator")
  auditLogs     AuditLog[]
  recordedTimes RunTime[]  @relation("RecordedTimes")
  accounts      Account[]
  sessions      Session[]
  managedUsers  User[]      @relation("UserManager")
  managedBy     User?       @relation("UserManager", fields: [managedById], references: [id], onDelete: SetNull)
  ownedAthletes Athlete[]   @relation("AthleteOwner")
  ownedArenas   Arena[]     @relation("ArenaOwner")
  reviewedAccessRequests AccessRequest[] @relation("AccessRequestReviewer")

  @@index([role, active])
  @@index([managedById])
}

model AccessRequest {
  id           String              @id @default(cuid())
  name         String
  phone        String
  email        String
  status       AccessRequestStatus @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  reviewedBy User? @relation("AccessRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([email, status])
  @@index([status, createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Arena {
  id        String   @id @default(cuid())
  name      String
  city      String
  state     String   @db.VarChar(2)
  address   String?
  active    Boolean  @default(true)
  ownerId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events Event[]
  owner  User? @relation("ArenaOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([city, state])
  @@index([ownerId])
}

model Event {
  id          String      @id @default(cuid())
  name        String
  eventDate   DateTime
  status      EventStatus @default(DRAFT)
  description String?
  arenaId     String
  createdById String
  publishedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  arena         Arena          @relation(fields: [arenaId], references: [id])
  createdBy     User           @relation("EventCreator", fields: [createdById], references: [id])
  registrations EventRegistration[]
  draws         Draw[]
  auditLogs     AuditLog[]

  @@index([status, eventDate])
  @@index([arenaId])
  @@index([createdById])
}

model Athlete {
  id              String   @id @default(cuid())
  registrationNo  String?  @unique
  name            String
  nickname        String?
  phone           String?
  email           String?
  city            String?
  state           String?  @db.VarChar(2)
  headHandicap    Decimal  @db.Decimal(3, 1)
  heelHandicap    Decimal  @db.Decimal(3, 1)
  active          Boolean  @default(true)
  ownerId         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  registrations   EventRegistration[]
  headRuns        Run[]    @relation("HeadAthlete")
  heelRuns        Run[]    @relation("HeelAthlete")
  owner           User?    @relation("AthleteOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([name])
  @@index([city, state])
  @@index([active])
  @@index([ownerId])
}

model EventRegistration {
  id                 String             @id @default(cuid())
  eventId            String
  athleteId          String
  category           String?
  status             RegistrationStatus @default(ACTIVE)
  paymentStatus      String?
  registeredAt       DateTime           @default(now())
  cancelledAt        DateTime?

  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  athlete Athlete @relation(fields: [athleteId], references: [id])

  @@unique([eventId, athleteId])
  @@index([eventId, status])
}

model Draw {
  id               String     @id @default(cuid())
  eventId          String
  version          Int        @default(1)
  status           DrawStatus  @default(DRAFT)
  configuration    Json
  generatedById    String?
  generatedAt      DateTime?
  publishedAt      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  runs  Run[]

  @@unique([eventId, version])
  @@index([eventId, status])
}

model Run {
  id              String     @id @default(cuid())
  drawId          String
  runNumber       Int
  phase           Int
  round           Int
  battery         Int
  headAthleteId   String
  heelAthleteId   String
  headGroup       String?
  heelGroup       String?
  combinedHandicap Decimal   @db.Decimal(4, 1)
  numberOfBulls   Int        @default(1)
  status          RunStatus  @default(PENDING)
  totalTime       Decimal?   @db.Decimal(8, 2)
  averageTime     Decimal?   @db.Decimal(8, 2)
  isNt            Boolean    @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  draw        Draw     @relation(fields: [drawId], references: [id], onDelete: Cascade)
  headAthlete Athlete  @relation("HeadAthlete", fields: [headAthleteId], references: [id])
  heelAthlete Athlete  @relation("HeelAthlete", fields: [heelAthleteId], references: [id])
  times       RunTime[]

  @@unique([drawId, runNumber])
  @@index([drawId, battery, runNumber])
  @@index([headAthleteId])
  @@index([heelAthleteId])
}

model RunTime {
  id           String   @id @default(cuid())
  runId        String
  bullNumber   Int
  timeSeconds  Decimal? @db.Decimal(8, 2)
  isNt         Boolean  @default(false)
  recordedById String
  recordedAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt

  run        Run  @relation(fields: [runId], references: [id], onDelete: Cascade)
  recordedBy User @relation("RecordedTimes", fields: [recordedById], references: [id])

  @@unique([runId, bullNumber])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  eventId    String?
  entityType String
  entityId   String
  action     String
  beforeData Json?
  afterData  Json?
  createdAt  DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id])
  event Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([eventId, createdAt])
  @@index([userId, createdAt])
}
